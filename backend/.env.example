# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secure_sheets?schema=public"

# JWT
JWT_ACCESS_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS="30"

# Redis
REDIS_URL="redis://localhost:6379"

# App
PORT=4000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
